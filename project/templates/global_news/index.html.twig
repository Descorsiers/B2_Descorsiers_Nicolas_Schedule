{% extends 'base.html.twig' %}

{% block title %}GlobalNews index{% endblock %}

{% block body %}
<section class="newsList">
    <h1>
        Liste des news
    </h1>
    <div class="newsListContent">
        {% for news in global_news %}
            <div class="newsListContainer">
                <ul class="newsListContainerList">
                    <li class="newsListContainerList__item">
                        {{ news.title }}
                    </li>
                    <li class="newsListContainerList__item">
                        {{ news.description }}
                    </li>
                    <li class="newsListContainerList__item">
                        <figure class="newsListPicture">
                            <img src="{{ asset('images/news/leavemealone-67d58474bd2e7879780624.jpg') }}" alt="Image de la news">
                        </figure>
                    </li>
                </ul>
                <a href="{{ path('app_global_news_edit', {'id': news.id}) }}">
					<i class="fa-solid fa-pen"></i>
				</a>
            </div>
        {% endfor %}
    </div>
</section>
    <a href="{{ path('app_global_news_new') }}">Create new</a>
{% endblock %}
