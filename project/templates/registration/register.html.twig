{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <section class="registration">
        {{ form_start(registrationForm, { 'attr': { 'class': "registrationForm" } }) }}
            <h1>
                Créer son compte
            </h1>
            <div class="scheduleFormContent">
                {{ form_label(registrationForm.email, 'Email', { 'label_attr': { 'class': "scheduleFormLabel" } }) }}
                {{ form_widget(registrationForm.email, { 'attr': { 'class': "scheduleFormInput" } }) }}
            </div>
            <div class="scheduleFormContent">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', { 'label_attr': { 'class': "scheduleFormLabel" } }) }}
                {{ form_widget(registrationForm.plainPassword, { 'attr': { 'class': "scheduleFormInput" } }) }}
            </div>
            <div class="scheduleFormButton">
                <button>
                    S'inscrire
                </button>
                <a href="{{ path("app_login") }}">
                    Se connecter
                </a>
            </div>
    {{ form_end(registrationForm) }}
    </section>
{% endblock %}
