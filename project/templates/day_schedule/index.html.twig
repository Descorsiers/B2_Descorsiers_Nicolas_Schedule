{% extends 'base.html.twig' %}

{% block title %}Liste des jours
{% endblock %}

{% block body %}
	<section id="scheduleList">
		<h1>
			Listes des jours
		</h1>
		<div class="scheduleListContainer">
			<ul class="defineList">
				<li class="defineList__item">
					Jour
				</li>
				<li class="defineList__item">
					Période
				</li>
				<li class="defineList__item">
					Année
				</li>
				<li class="defineList__item">
					Sujet
				</li>
				<li class="defineList__item">
					Professeur
				</li>
				<li class="defineList__item">
					Date
				</li>
			</ul>
			<div class="scheduleListContent">
				{% for day_schedule in day_schedules %}
					<div class="contentContainer">
						<ul class="contentContainerList">
							<li class="contentContainerList__item">
								{{ day_schedule.name.name }}
							</li>
							<li class="contentContainerList__item">
								{{ day_schedule.schedule.name }}
							</li>
							<li class="contentContainerList__item">
								{{ day_schedule.grade.name }}
							</li>
							<li class="contentContainerList__item">
								{{ day_schedule.subject }}
							</li>
							<li class="contentContainerList__item">
								{{ day_schedule.teacher }}
							</li>
							<li class="contentContainerList__item">
								{{ day_schedule.date|date('d-m-y') }}
							</li>
						</ul>
						<a href="{{ path('app_day_schedule_edit', {'id': day_schedule.id}) }}">
							<i class="fa-solid fa-pen"></i>
						</a>
					</div>
				{% endfor %}
			</div>
		</div>
        <div class="scheduleListRedirection">
			<a href="{{ path('app_day_schedule_new') }}">
				Ajouter un jour
			</a>
			<a href="{{ path('app_global_news_index') }}">
				Liste des news
			</a>
		</div>
	</section>
{% endblock %}
